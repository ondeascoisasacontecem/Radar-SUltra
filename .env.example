# Copie para .env e preencha só o que tiver. Nada aqui é obrigatório.
PORT=8787
# 127.0.0.1 = só este PC. Use 0.0.0.0 apenas atrás de Tailscale/rede confiável.
HOST=127.0.0.1
KABUM_INTERVAL_MIN=60
KABUM_MAX_PRODUCTS=8

# Mercado Livre (dependente de credencial): app em https://developers.mercadolivre.com.br
ML_ACCESS_TOKEN=
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
ML_INTERVAL_MIN=60

# Web Push: gerado automaticamente em data/vapid.json se vazio
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
